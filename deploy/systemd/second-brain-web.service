[Unit]
Description=Second Brain loopback web API for desktop clients
Documentation=file:%h/.local/share/doc/second-brain/OPERATIONS.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=SB_CONFIG=%h/.config/second-brain/config.toml
EnvironmentFile=-%h/.config/second-brain/environment
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env sb web --host 127.0.0.1 --port 8765
Restart=on-failure
RestartSec=3s
TimeoutStopSec=15s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=-%h/.local/share/second-brain -%h/.local/state/second-brain -%h/.config/second-brain
UMask=0077

[Install]
WantedBy=default.target
