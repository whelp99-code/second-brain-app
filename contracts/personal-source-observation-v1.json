{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:second-brain:personal-source-observation:v1",
  "title": "SourceObservationV1",
  "description": "K1 exact wire fields. The observation ID is sha256:<hex> of UTF-8 second-brain/personal-source-observation/v1 followed by NUL and canonical JSON of namespace, account_id, source_id, event_id, revision. Canonical JSON sorts keys, uses compact separators, literal NFC UTF-8 and no NaN. All numbers are JS-safe integers. Original bytes have a plain lowercase SHA-256. A server-owned manifest binds authenticated emitter/account/root to namespace/source/policy; body hints grant no authority. Same identity/revision with different content is SOURCE_REVISION_CONFLICT. UTC instants use milliseconds; original_timestamp retains its offset and date-only remains date-only. Evidence locators are opaque references, never instructions to read arbitrary paths.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "namespace", "account_id", "source_id", "event_id", "revision", "content_sha256", "parser_version", "normalization_version", "occurred_at", "source_updated_at", "ingested_at", "original_timestamp", "source_timezone", "timestamp_precision", "capture_mode", "source_policy_revision", "evidence_locator", "evidence_spans", "supersedes_observation_id", "source_deleted"],
  "properties": {
    "schema_version": {"const": 1, "type": "integer"},
    "namespace": {"type": "string", "pattern": "^(personal|company:[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12})$"},
    "account_id": {"$ref": "#/$defs/text"},
    "source_id": {"$ref": "#/$defs/text"},
    "event_id": {"$ref": "#/$defs/text"},
    "revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "parser_version": {"$ref": "#/$defs/text"},
    "normalization_version": {"$ref": "#/$defs/text"},
    "occurred_at": {"oneOf": [{"$ref": "#/$defs/instant"}, {"$ref": "#/$defs/day"}, {"type": "null"}]},
    "source_updated_at": {"oneOf": [{"$ref": "#/$defs/instant"}, {"type": "null"}]},
    "ingested_at": {"$ref": "#/$defs/instant"},
    "original_timestamp": {"oneOf": [{"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3})?(Z|[+-][0-9]{2}:[0-9]{2})$"}, {"$ref": "#/$defs/day"}, {"type": "null"}]},
    "source_timezone": {"oneOf": [{"$ref": "#/$defs/text"}, {"type": "null"}], "description": "IANA timezone or null when unknown; original offset must agree when known."},
    "timestamp_precision": {"enum": ["unknown", "day", "minute", "second", "millisecond"]},
    "capture_mode": {"enum": ["automatic", "manual", "import"]},
    "source_policy_revision": {"$ref": "#/$defs/text"},
    "evidence_locator": {"$ref": "#/$defs/text"},
    "evidence_spans": {"type": "array", "maxItems": 1024, "items": {"$ref": "#/$defs/span"}},
    "supersedes_observation_id": {"oneOf": [{"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, {"type": "null"}]},
    "source_deleted": {"type": "boolean"}
  },
  "allOf": [
    {"if": {"properties": {"timestamp_precision": {"const": "unknown"}}}, "then": {"properties": {"occurred_at": {"type": "null"}, "original_timestamp": {"type": "null"}}}},
    {"if": {"properties": {"timestamp_precision": {"const": "day"}}}, "then": {"properties": {"occurred_at": {"$ref": "#/$defs/day"}, "original_timestamp": {"$ref": "#/$defs/day"}}}},
    {"if": {"properties": {"timestamp_precision": {"enum": ["minute", "second", "millisecond"]}}}, "then": {"properties": {"occurred_at": {"$ref": "#/$defs/instant"}, "original_timestamp": {"type": "string", "format": "date-time"}}}},
    {"if": {"properties": {"timestamp_precision": {"const": "millisecond"}}}, "then": {"properties": {"original_timestamp": {"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}(Z|[+-][0-9]{2}:[0-9]{2})$"}}}}
  ],
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^\\u0000-\\u001f]*[^\\s\\u0000-\\u001f][^\\u0000-\\u001f]*$"},
    "instant": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},
    "day": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "span": {
      "description": "Half-open zero-based positions with end > start. Byte spans must fit supplied original bytes; audio_ms measures milliseconds. Runtime validation checks relational bounds.",
      "type": "object", "additionalProperties": false, "required": ["kind", "start", "end"],
      "properties": {
        "kind": {"enum": ["byte", "character", "line", "page", "audio_ms"]},
        "start": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "end": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
      }
    }
  }
}
