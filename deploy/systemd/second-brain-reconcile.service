[Unit]
Description=Second Brain approved write-request reconciliation
Documentation=file:%h/.local/share/doc/second-brain/OPERATIONS.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=SB_CONFIG=%h/.config/second-brain/config.toml
EnvironmentFile=-%h/.config/second-brain/environment
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env sb reconcile --json
TimeoutStartSec=15min
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=-%h/.local/share/second-brain -%h/.config/second-brain
UMask=0077

[Install]
WantedBy=default.target
