[Unit]
Description=Apply one stable Second Brain request
ConditionPathIsDirectory=%h/.local/state/second-brain/requests/pending

[Service]
Type=oneshot
ExecStart=/usr/bin/env sb apply-requests --once
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/second-brain %h/.local/share/second-brain
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
UMask=0077
