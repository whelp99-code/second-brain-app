[Unit]
Description=Second Brain ingest, compile, and briefing run
Documentation=file:%h/.local/share/doc/second-brain/OPERATIONS.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=SB_CONFIG=%h/.config/second-brain/config.toml
EnvironmentFile=-%h/.config/second-brain/environment
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env sb run
TimeoutStartSec=45min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
NoNewPrivileges=true
PrivateTmp=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=-%h/.local/share/second-brain -%h/.config/second-brain
UMask=0077

[Install]
WantedBy=default.target
